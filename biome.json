{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/.pages",
			"!**/.cache",
			"!**/.astro",
			"!**/playwright-report",
			"!**/test-results"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
