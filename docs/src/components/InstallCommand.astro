---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";
import { graphraumDocsVersion as version } from "../lib/docs-version";
import { installCommands } from "../lib/install-commands";

const commands = installCommands(version.packageSpec ?? undefined);
---

<Tabs syncKey="package-manager">
	{
		commands.map(({ manager, command }) => (
			<TabItem label={manager}>
				<Code code={command} lang="sh" />
			</TabItem>
		))
	}
</Tabs>
