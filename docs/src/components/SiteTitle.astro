---
import Default from "@astrojs/starlight/components/SiteTitle.astro";
import { graphraumDocsVersion as version } from "../lib/docs-version";
import { sitePath } from "../lib/site-path";

const base = sitePath();
---

<div class="versioned-site-title">
  <Default />
  <a href={version.referenceUrl} aria-label={`Documentation for ${version.display}`}>{version.display}</a>
</div>
<nav class="site-nav" aria-label="Site">
  <a href={`${base}get-started/`} aria-current="page">Docs</a>
  <a href={`${base}playground/`}>Playground</a>
  <a class="site-nav-github" href="https://github.com/yggy-tech/graphraum">GitHub</a>
</nav>
