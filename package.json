{
	"name": "@yggy-tech/graphraum",
	"version": "0.2.2",
	"description": "yggy's WebGL engine for interactive graphs in 2D and 3D",
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "bun@1.3.1",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yggy-tech/graphraum.git"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./diagnostics": {
			"types": "./dist/diagnostics.d.ts",
			"import": "./dist/diagnostics.js"
		},
		"./styles": {
			"types": "./dist/styles.d.ts",
			"import": "./dist/styles.js"
		},
		"./layout": {
			"types": "./dist/layout.d.ts",
			"import": "./dist/layout.js"
		},
		"./layout-start": {
			"types": "./dist/layout-start.d.ts",
			"import": "./dist/layout-start.js"
		},
		"./lod": {
			"types": "./dist/lod.d.ts",
			"import": "./dist/lod.js"
		},
		"./layout-multilevel": {
			"types": "./dist/layout-multilevel.d.ts",
			"import": "./dist/layout-multilevel.js"
		},
		"./icons": {
			"types": "./dist/icons.d.ts",
			"import": "./dist/icons.js"
		}
	},
	"scripts": {
		"api:check": "api-extractor run && api-extractor run -c api-extractor.diagnostics.json && api-extractor run -c api-extractor.styles.json && api-extractor run -c api-extractor.layout.json && api-extractor run -c api-extractor.layout-start.json && api-extractor run -c api-extractor.lod.json && api-extractor run -c api-extractor.layout-multilevel.json && api-extractor run -c api-extractor.icons.json",
		"api:update": "api-extractor run --local && api-extractor run --local -c api-extractor.diagnostics.json && api-extractor run --local -c api-extractor.styles.json && api-extractor run --local -c api-extractor.layout.json && api-extractor run --local -c api-extractor.layout-start.json && api-extractor run --local -c api-extractor.lod.json && api-extractor run --local -c api-extractor.layout-multilevel.json && api-extractor run --local -c api-extractor.icons.json",
		"bench": "bun scripts/bench.ts",
		"bench:chart": "bun scripts/bench-chart.ts",
		"build": "tsdown",
		"check": "biome check . && tsc --noEmit",
		"check:package": "publint && attw --pack . --profile esm-only && bun scripts/check-bundle-size.ts",
		"dev": "vite examples/benchmark",
		"dev:lod": "vite examples/cluster-lod",
		"dev:showcase": "vite examples/showcase",
		"docs:build": "bun run --cwd docs build",
		"docs:archive": "bun run docs/scripts/build-release-archives.ts",
		"docs:check": "bun run --cwd docs check",
		"docs:dev": "bun run --cwd docs dev",
		"docs:test": "bun run --cwd docs test",
		"prepack": "bun run build",
		"release": "semantic-release",
		"test": "vitest run src examples bench/ --exclude 'docs/**' --exclude '**/*.browser.test.ts'",
		"test:browser": "vitest run --config vitest.browser.config.ts"
	},
	"engines": {
		"bun": ">=1.2.0"
	},
	"dependencies": {
		"graphology": "^0.26.0",
		"graphology-types": "^0.24.8",
		"three": "^0.187.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "^2.5.5",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@microsoft/api-extractor": "7.60.1",
		"@types/three": "^0.187.0",
		"@vitest/browser-playwright": "5.1.0",
		"playwright": "1.65.0",
		"publint": "0.3.25",
		"semantic-release": "^25.0.8",
		"tsdown": "^0.23.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^5.0.5"
	}
}
