{
	"name": "@yggy-tech/graphraum",
	"version": "0.2.2",
	"description": "yggy's WebGL engine for interactive graphs in 2D and 3D",
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "bun@1.3.1",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yggy-tech/graphraum.git"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"api:check": "api-extractor run",
		"api:update": "api-extractor run --local",
		"build": "tsdown",
		"check": "biome check . && tsc --noEmit",
		"check:package": "publint && attw --pack . --profile esm-only && bun scripts/check-bundle-size.ts",
		"dev": "vite examples/benchmark",
		"docs:build": "bun run --cwd docs build",
		"docs:archive": "bun run docs/scripts/build-release-archives.ts",
		"docs:check": "bun run --cwd docs check",
		"docs:dev": "bun run --cwd docs dev",
		"docs:test": "bun run --cwd docs test",
		"prepack": "bun run build",
		"release": "semantic-release",
		"test": "vitest run src examples --exclude 'docs/**' --exclude '**/*.browser.test.ts'",
		"test:browser": "vitest run --config vitest.browser.config.ts"
	},
	"engines": {
		"bun": ">=1.2.0"
	},
	"dependencies": {
		"graphology": "^0.26.0",
		"three": "^0.185.1"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "^2.5.5",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@microsoft/api-extractor": "7.60.0",
		"@types/three": "^0.185.1",
		"@vitest/browser-playwright": "4.1.10",
		"playwright": "1.64.1",
		"publint": "0.3.25",
		"semantic-release": "^25.0.8",
		"tsdown": "^0.22.13",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
